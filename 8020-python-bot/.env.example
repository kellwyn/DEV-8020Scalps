# MT5 credentials — use keyring instead (see CREDENTIALS.md in Dev-RZY)
# Store via:  python -c "import keyring; keyring.set_password('mt5','8020_login','YOUR_ACCOUNT')"
# These env vars are only a fallback if keyring is not set up
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=
MT5_PATH=                  # path to terminal64.exe if running multiple MT5 instances

# Keyring profile name (default: 8020)
KEYRING_PROFILE=8020

# Instrument override
SYMBOL=NQ100m              # adjust to broker symbol: NQ, MNQ, NAS100, NQ100m
